// CO/CO2 热催化加氢 核壳限域与接力催化技术谱系 — 统一主图(8节点双轨)
// 统一样式：rankdir=LR / 白底 / 圆角矩形 / 底部图例 / 旧→新
// 数据来源：lineage_cases_unified/co_co2_hydrogenation/{nodes.csv,edges.csv}
// 保持蓝(核壳限域)/绿(分子筛接力)双轨结构；三线型：实线/点划线(基线)/虚线(路线)
// 化学式下标用 HTML-like <SUB> 保证正确渲染
digraph co_lineage {
  graph [rankdir=LR, splines=spline, newrank=true, bgcolor="white",
         fontname="Microsoft YaHei", fontsize=12, pad=0.10, margin=0,
         ranksep=1.12, nodesep=0.42, ratio=compress,
         labelloc=b, labeljust=c,
         label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="10" CELLPADDING="3">
 <TR>
  <TD BGCOLOR="#E5E7EB"><FONT POINT-SIZE="10" COLOR="#374151">　传统基线　</FONT></TD>
  <TD BGCOLOR="#DBEAFE"><FONT POINT-SIZE="10" COLOR="#1E3A8A">　核壳限域(主路线)　</FONT></TD>
  <TD BGCOLOR="#DCFCE7"><FONT POINT-SIZE="10" COLOR="#14532D">　分子筛接力(主路线)　</FONT></TD>
  <TD><FONT POINT-SIZE="10" COLOR="#111827">　━━━ 直接演化</FONT></TD>
  <TD><FONT POINT-SIZE="10" COLOR="#C65A00">━·━·━ 基线比较</FONT></TD>
  <TD><FONT POINT-SIZE="10" COLOR="#71839B">- - - 路线归类</FONT></TD>
 </TR>
</TABLE>>];
  node  [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=11,
         margin="0.14,0.09", penwidth=1.4, fontcolor="#111827"];
  edge  [fontname="Microsoft YaHei", fontsize=9, arrowsize=0.8];

  // ---- 传统基线(灰) ----
  N01 [label=<FT负载型/体相型金属<BR/>(基线)>, fillcolor="#E5E7EB", color="#6B7280"];
  N02 [label=<物理混合双功能<BR/>(基线)>, fillcolor="#E5E7EB", color="#6B7280"];

  // ---- 核壳限域·主路线(蓝) ----
  N38 [label=<Fe-in-CNTs<BR/>(CNT限域)>, fillcolor="#DBEAFE", color="#2563EB"];
  N39 [label=<FeN-in-CNTs>, fillcolor="#DBEAFE", color="#2563EB"];
  N29 [label=<甲基改性Fe<SUB>2</SUB>O<SUB>3</SUB>@SiO<SUB>2</SUB><BR/>(疏水)>, fillcolor="#DBEAFE", color="#2563EB"];
  N30 [label=<FeMn@Si<BR/>(疏水·Science)>, fillcolor="#DBEAFE", color="#2563EB"];

  // ---- 分子筛接力·主路线(绿) ----
  N55 [label=<Co/SiO<SUB>2</SUB>@H-ZSM-5<BR/>胶囊>, fillcolor="#DCFCE7", color="#16A34A"];
  N59 [label=<FeMn@Hollow HZSM-5<BR/>(蛋黄@壳)>, fillcolor="#DCFCE7", color="#16A34A"];

  // ==== 直接演化 solid ====
  edge [color="#111827", penwidth=1.8, style=solid];
  N29 -> N30 [label="EXTENDS"];

  // ==== 节点级性能比较 / 基线性能比较 dash_dot(占位 dashed, 后处理注入点划线) ====
  edge [color="#C65A00", penwidth=1.5, style=dashed];
  N38 -> N39 [label="性能改进5～7×", class="rel-basecmp"];
  N01 -> N38 [label="基线比较", class="rel-basecmp"];
  N02 -> N59 [label="基线比较", class="rel-basecmp"];

  // ==== 路线关联 dashed ====
  edge [color="#71839B", penwidth=1.3, style=dashed];
  N01 -> N29 [label="路线归类", class="rel-route", constraint=false];
  N02 -> N55 [label="路线归类", class="rel-route"];
  N55 -> N59 [label="路线归类", class="rel-route"];

  // ---- 年份轴(高权重保持水平) ----
  { node [shape=plaintext, style="", fontcolor="#6B7280", fontsize=10];
    ybase [label="传统基线"]; y0507 [label="2005–2007"]; y2008 [label="2008"];
    y2011 [label="2011"]; y2018 [label="2018"]; y2021 [label="2021"];
    edge [color="#9CA3AF", penwidth=1.0, style=solid, arrowhead=none, class="axis", weight=100];
    ybase -> y0507 -> y2008 -> y2011 -> y2018 -> y2021;
  }
  // 绑定节点到年份列
  { rank=same; ybase; N01; N02; }
  { rank=same; y0507; N55; }
  { rank=same; y2008; N38; }
  { rank=same; y2011; N39; }
  { rank=same; y2018; N29; }
  { rank=same; y2021; N30; N59; }

  // 年份轴置顶
  ybase -> N01 [style=invis];
  y0507 -> N55 [style=invis];
  y2008 -> N38 [style=invis];
  y2011 -> N39 [style=invis];
  y2018 -> N29 [style=invis];
  y2021 -> N30 [style=invis];

  // 列内竖直次序(蓝轨在上、绿轨在下；基线列 N01 在上)
  N01 -> N02 [style=invis];
  N30 -> N59 [style=invis];
}
